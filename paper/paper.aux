\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces GSM8K ablation ($N=200$ sub-sample): VIB with / without role-aware weights (\S  2.2). With role weights off (``frozen\_only''), VIB already saves $+30.25\%$ messages; with role weights on (``frozen+role''), compression drops slightly to $+25.17\%$ but the accuracy gap vs Full closes to exactly 0.00 pp, showing VIB is robust to both history modes. }}{6}{table.3}\protected@file@percent }
\newlabel{tab:gsm8k_ablation}{{3}{6}{GSM8K ablation ($N=200$ sub-sample): VIB with / without role-aware weights (\S 2.2). With role weights off (``frozen\_only''), VIB already saves $+30.25\%$ messages; with role weights on (``frozen+role''), compression drops slightly to $+25.17\%$ but the accuracy gap vs Full closes to exactly 0.00 pp, showing VIB is robust to both history modes}{table.3}{}}
\newlabel{tab:gsm8k_ablation@cref}{{[table][3][]3}{[1][6][]6}}
